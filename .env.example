# Optional until the final domain has been chosen. Set an HTTPS origin with no
# path, then rebuild. This enables canonicals, absolute share images, the sitemap
# and indexing. Leaving it blank keeps review deployments noindex.
SITE_URL=

# Optional confirmed HTTPS JSON inquiry handler. Leave blank to retain the
# existing phone-only inquiry notice. This value is public and must not be a secret.
NEXT_PUBLIC_INQUIRY_ENDPOINT=
